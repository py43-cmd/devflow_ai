# Server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/devflow
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call this API.
# Localhost is always allowed; add your deployed frontend here, e.g.
# CLIENT_ORIGINS=https://devflow-ai.vercel.app,https://*.vercel.app
CLIENT_ORIGINS=

# AI configuration (backend only - placeholders, never commit real values)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible host (OpenAI, Groq, OpenRouter, local, ...)
AI_BASE_URL=https://api.openai.com/v1
# Optional: request timeout in milliseconds
AI_TIMEOUT_MS=30000
# Optional: embeddings model; falls back to a deterministic offline vector
# when no key is configured, which is what the tests use
AI_EMBEDDING_MODEL=text-embedding-3-small
